# Local development must use the CIV development Neon branch.
APP_ENV="development"

# Pooled Neon URL used by the running application. Keep the -pooler hostname.
DATABASE_URL="postgresql://USER:PASSWORD@ep-development-pooler.REGION.aws.neon.tech/civ?sslmode=require"

# Direct Neon URL for Prisma migrations, seed, and administrative workflows.
DIRECT_URL="postgresql://USER:PASSWORD@ep-development.REGION.aws.neon.tech/civ?sslmode=require"

# Generate a unique development secret. Never reuse it in production.
AUTH_SECRET="<generate-a-secure-secret>"

# Google OAuth credentials for the local CIV development callback.
AUTH_GOOGLE_ID="<google-oauth-client-id>"
AUTH_GOOGLE_SECRET="<google-oauth-client-secret>"

# Existing CIV user email used only by the guarded development owner bootstrap.
CIV_PLATFORM_OWNER_EMAIL="<existing-civ-user-email>"

# Private Cloudflare R2 development bucket. Keep real values in ignored .env only.
R2_ACCOUNT_ID="<cloudflare-account-id>"
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
R2_BUCKET_NAME="civ-private"
R2_ENDPOINT="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
R2_REGION="auto"

# Canonical development origin used for payment callbacks. Webhook testing requires a public HTTPS origin.
APP_URL="http://localhost:3000"

# Paystack Test Mode only. Never place the secret key in client-side variables.
PAYSTACK_PUBLIC_KEY="pk_test_<paystack-test-public-key>"
PAYSTACK_SECRET_KEY="sk_test_<paystack-test-secret-key>"
PAYSTACK_MODE="test"
PAYSTACK_BASE_URL="https://api.paystack.co"
