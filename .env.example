# Local development must use the CIV development Neon branch.
APP_ENV="development"

# Pooled Neon URL used by the running application. Keep the -pooler hostname.
DATABASE_URL="postgresql://USER:PASSWORD@ep-development-pooler.REGION.aws.neon.tech/civ?sslmode=require"

# Direct Neon URL for Prisma migrations, seed, and administrative workflows.
DIRECT_URL="postgresql://USER:PASSWORD@ep-development.REGION.aws.neon.tech/civ?sslmode=require"

# Generate a unique development secret. Never reuse it in production.
AUTH_SECRET="<generate-a-secure-secret>"
