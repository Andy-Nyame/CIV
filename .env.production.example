# Configure these values in the deployment platform, not in a committed file.
APP_ENV="production"

# Pooled Neon URL for the CIV production branch runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-production-pooler.REGION.aws.neon.tech/civ?sslmode=require"

# Direct Neon URL reserved for an explicitly authorized production migration.
DIRECT_URL="postgresql://USER:PASSWORD@ep-production.REGION.aws.neon.tech/civ?sslmode=require"

# Configure a separate production-only secret in the deployment environment.
AUTH_SECRET="<generate-a-secure-secret>"

# Configure separate production Google OAuth credentials at deployment time.
AUTH_GOOGLE_ID="<google-oauth-client-id>"
AUTH_GOOGLE_SECRET="<google-oauth-client-secret>"

# Configure separate production R2 credentials in the deployment environment.
R2_ACCOUNT_ID="<production-cloudflare-account-id>"
R2_ACCESS_KEY_ID="<production-r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<production-r2-secret-access-key>"
R2_BUCKET_NAME="<production-private-bucket-name>"
R2_ENDPOINT="https://<production-cloudflare-account-id>.r2.cloudflarestorage.com"
R2_REGION="auto"
