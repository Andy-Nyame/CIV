generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  INDIVIDUAL
  BUSINESS
  ORGANIZATION
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DocumentType {
  INVOICE
  RECEIPT
  QUOTATION
  TAX_INVOICE
}

enum DocumentStatus {
  DRAFT
  ISSUED
  VOIDED
}

enum RateType {
  PERCENTAGE
  FIXED
}

enum RateScope {
  CUSTOM
  STATUTORY
}

enum SubscriptionStatus {
  BETA
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PlanBillingMode {
  FREE
  RECURRING
  CUSTOM
}

enum SubscriptionChangeStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum SubscriptionBillingPeriodStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum FileType {
  ORIGINAL_PDF
  CUSTOMER_PDF
  LOGO
  SIGNATURE
  STAMP
  OTHER
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  ANALYST
  SUPPORT
  FINANCE
}

enum PlatformMembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum PlatformInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DocumentCreditPurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum DocumentCreditTransactionType {
  PURCHASE
  USAGE
  ADMIN_ADJUSTMENT
  REFUND
  BONUS
}

enum WorkspaceTrialStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  CONVERTED
}

enum TrialGrantSource {
  AUTO_NEW_WORKSPACE
  PLATFORM_MANUAL
  PAYMENT_CONVERSION
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentPurpose {
  BILLING_TEST
  DOCUMENT_CREDITS
  SUBSCRIPTION_INITIAL
  SUBSCRIPTION_RENEWAL
  MANUAL_PLAN_RENEWAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentAttemptStatus {
  PENDING
  INITIALIZED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum PaymentRefundStatus {
  REQUESTED
  PROCESSING
  NEEDS_ATTENTION
  SUCCEEDED
  FAILED
}

enum PaymentReconciliationStatus {
  NOT_REQUIRED
  REQUIRED
  RESOLVED
}

model User {
  id                           String                      @id @default(uuid()) @db.Uuid
  name                         String?                     @db.VarChar(200)
  email                        String?                     @unique @db.VarChar(320)
  emailVerified                DateTime?                   @db.Timestamptz(3)
  image                        String?                     @db.Text
  passwordHash                 String?                     @db.Text
  passwordChangedAt            DateTime?                   @db.Timestamptz(3)
  createdAt                    DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                    @updatedAt @db.Timestamptz(3)
  accounts                     Account[]
  sessions                     Session[]
  memberships                  Membership[]
  platformMembership           PlatformMembership?
  sentPlatformInvitations      PlatformInvitation[]        @relation("PlatformInvitationInviter")
  platformAuditEvents          PlatformAuditEvent[]        @relation("PlatformAuditActor")
  documentCreditPurchases      DocumentCreditPurchase[]    @relation("DocumentCreditPurchaseActor")
  documentCreditTransactions   DocumentCreditTransaction[] @relation("DocumentCreditTransactionActor")
  grantedWorkspaceTrials       WorkspaceTrial[]            @relation("WorkspaceTrialGrantor")
  initiatedPayments            Payment[]                   @relation("PaymentInitiator")
  initiatedPaymentRefunds      PaymentRefund[]             @relation("PaymentRefundInitiator")
  initiatedSubscriptionChanges SubscriptionChange[]        @relation("SubscriptionChangeActor")
  profilePhoto                 ProfilePhoto?
  signatureProfile             SignatureProfile?
  sentInvitations              Invitation[]                @relation("InvitationInviter")
  createdDocuments             Document[]                  @relation("DocumentCreator")
  auditEvents                  AuditEvent[]                @relation("AuditActor")

  @@index([createdAt])
}

model PlatformMembership {
  id        String                   @id @default(uuid()) @db.Uuid
  userId    String                   @unique @db.Uuid
  role      PlatformRole
  status    PlatformMembershipStatus @default(ACTIVE)
  createdAt DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                 @updatedAt @db.Timestamptz(3)
  user      User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([role], map: "PlatformMembership_single_active_owner_key", where: { role: "PLATFORM_OWNER", status: "ACTIVE" })
  @@index([status, role])
}

model PlatformInvitation {
  id              String                   @id @default(uuid()) @db.Uuid
  email           String                   @db.VarChar(320)
  role            PlatformRole
  status          PlatformInvitationStatus @default(PENDING)
  tokenHash       String                   @unique @db.Char(64)
  invitedByUserId String                   @db.Uuid
  expiresAt       DateTime                 @db.Timestamptz(3)
  acceptedAt      DateTime?                @db.Timestamptz(3)
  revokedAt       DateTime?                @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  invitedBy       User                     @relation("PlatformInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([email], map: "PlatformInvitation_pending_email_key", where: { status: "PENDING" })
  @@index([status, expiresAt])
  @@index([email, status])
  @@index([invitedByUserId])
}

model PlatformAuditEvent {
  id               String   @id @default(uuid()) @db.Uuid
  action           String   @db.VarChar(150)
  actorUserId      String?  @db.Uuid
  actorDisplayName String?  @db.VarChar(320)
  resourceType     String   @db.VarChar(100)
  resourceId       String?  @db.VarChar(100)
  metadata         Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  actor            User?    @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
}

model ProfilePhoto {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  storageKey String   @unique @db.VarChar(1024)
  mimeType   String   @db.VarChar(50)
  width      Int
  height     Int
  sizeBytes  Int
  checksum   String   @db.Char(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SignatureProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  storageKey String   @unique @db.VarChar(1024)
  mimeType   String   @db.VarChar(50)
  width      Int
  height     Int
  sizeBytes  Int
  checksum   String   @db.Char(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(100)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(100)
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @db.Text
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String   @db.VarChar(320)
  token      String   @db.Text
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

model Workspace {
  id                         String                             @id @default(uuid()) @db.Uuid
  name                       String                             @db.VarChar(200)
  type                       WorkspaceType
  country                    String                             @default("GH") @db.Char(2)
  currency                   String                             @default("GHS") @db.Char(3)
  email                      String?                            @db.VarChar(320)
  phone                      String?                            @db.VarChar(50)
  address                    String?                            @db.Text
  registrationNumber         String?                            @db.VarChar(100)
  businessTin                String?                            @db.VarChar(100)
  createdAt                  DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                           @updatedAt @db.Timestamptz(3)
  archivedAt                 DateTime?                          @db.Timestamptz(3)
  logo                       WorkspaceLogo?
  memberships                Membership[]
  invitations                Invitation[]
  customers                  Customer[]
  catalogItems               ItemService[]
  customRates                CustomRate[]
  documents                  Document[]
  files                      DocumentFile[]
  auditEvents                AuditEvent[]
  subscription               Subscription?
  documentCreditPurchases    DocumentCreditPurchase[]
  documentCreditTransactions DocumentCreditTransaction[]
  documentAllowancePeriods   WorkspaceDocumentAllowancePeriod[]
  trials                     WorkspaceTrial[]
  payments                   Payment[]
  paymentRefunds              PaymentRefund[]
  subscriptionChanges        SubscriptionChange[]

  @@index([type])
  @@index([archivedAt])
}

model WorkspaceLogo {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @unique @db.Uuid
  storageKey  String    @unique @db.VarChar(1024)
  mimeType    String    @db.VarChar(50)
  width       Int
  height      Int
  sizeBytes   Int
  checksum    String    @db.Char(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  workspaceId String           @db.Uuid
  role        MembershipRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @db.Uuid
  email           String           @db.VarChar(320)
  tokenHash       String           @unique @db.Char(64)
  role            MembershipRole
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @db.Uuid
  expiresAt       DateTime         @db.Timestamptz(3)
  acceptedAt      DateTime?        @db.Timestamptz(3)
  revokedAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invitedBy       User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, email], map: "Invitation_pending_workspace_email_key", where: { status: "PENDING" })
  @@index([workspaceId, status])
  @@index([email, status])
  @@index([invitedByUserId])
}

model Customer {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  name        String     @db.VarChar(200)
  email       String?    @db.VarChar(320)
  phone       String?    @db.VarChar(50)
  address     String?    @db.Text
  businessTin String?    @db.VarChar(100)
  notes       String?    @db.Text
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime?  @db.Timestamptz(3)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  documents   Document[]

  @@index([workspaceId])
  @@index([workspaceId, name])
  @@index([workspaceId, archivedAt])
}

model ItemService {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  name        String         @db.VarChar(200)
  description String?        @db.Text
  unitPrice   Decimal        @db.Decimal(19, 4)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime?      @db.Timestamptz(3)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  lines       DocumentLine[]

  @@index([workspaceId])
  @@index([workspaceId, name])
  @@index([workspaceId, archivedAt])
}

model CustomRate {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String    @db.VarChar(200)
  type        RateType
  scope       RateScope @default(CUSTOM)
  value       Decimal   @db.Decimal(19, 6)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
}

model TaxProfile {
  id           String       @id @default(uuid()) @db.Uuid
  jurisdiction String       @db.VarChar(2)
  code         String       @db.VarChar(100)
  name         String       @db.VarChar(200)
  description  String?      @db.Text
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  versions     TaxVersion[]

  @@unique([jurisdiction, code])
  @@index([jurisdiction])
}

model TaxVersion {
  id            String         @id @default(uuid()) @db.Uuid
  taxProfileId  String         @db.Uuid
  version       String         @db.VarChar(50)
  effectiveFrom DateTime       @db.Date
  effectiveTo   DateTime?      @db.Date
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  taxProfile    TaxProfile     @relation(fields: [taxProfileId], references: [id], onDelete: Restrict)
  components    TaxComponent[]
  documents     Document[]

  @@unique([taxProfileId, version])
  @@index([taxProfileId, effectiveFrom, effectiveTo])
  @@index([isActive, effectiveFrom])
}

model TaxComponent {
  id               String     @id @default(uuid()) @db.Uuid
  taxVersionId     String     @db.Uuid
  code             String     @db.VarChar(100)
  name             String     @db.VarChar(200)
  type             RateType   @default(PERCENTAGE)
  scope            RateScope  @default(STATUTORY)
  rate             Decimal    @db.Decimal(19, 6)
  calculationOrder Int
  baseReference    String?    @db.VarChar(100)
  metadata         Json?
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  taxVersion       TaxVersion @relation(fields: [taxVersionId], references: [id], onDelete: Restrict)

  @@unique([taxVersionId, code])
  @@index([taxVersionId, calculationOrder])
}

model Document {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @db.Uuid
  createdByUserId String            @db.Uuid
  customerId      String?           @db.Uuid
  taxVersionId    String?           @db.Uuid
  type            DocumentType
  status          DocumentStatus    @default(DRAFT)
  documentNumber  String?           @db.VarChar(100)
  civDocumentId   String?           @unique @db.VarChar(100)
  currency        String            @default("GHS") @db.VarChar(3)
  issueDate       DateTime?         @db.Date
  dueDate         DateTime?         @db.Date
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?         @db.Timestamptz(3)
  issuedAt        DateTime?         @db.Timestamptz(3)
  voidedAt        DateTime?         @db.Timestamptz(3)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy       User              @relation("DocumentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  taxVersion      TaxVersion?       @relation(fields: [taxVersionId], references: [id], onDelete: Restrict)
  lines           DocumentLine[]
  snapshot        DocumentSnapshot?
  files           DocumentFile[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, documentNumber])
  @@index([customerId])
  @@index([createdByUserId])
  @@index([taxVersionId])
}

model DocumentLine {
  id            String       @id @default(uuid()) @db.Uuid
  documentId    String       @db.Uuid
  catalogItemId String?      @db.Uuid
  description   String       @db.Text
  quantity      Decimal      @default(1) @db.Decimal(19, 6)
  unitPrice     Decimal      @db.Decimal(19, 4)
  lineOrder     Int
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  document      Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  catalogItem   ItemService? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@unique([documentId, lineOrder])
  @@index([catalogItemId])
}

model DocumentSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @unique @db.Uuid
  snapshotVersion Int      @default(1)
  payload         Json
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  document        Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
}

model DocumentFile {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  documentId  String?   @db.Uuid
  type        FileType
  storageKey  String    @unique @db.Text
  mimeType    String    @db.VarChar(255)
  sizeBytes   BigInt?
  checksum    String?   @db.VarChar(128)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([workspaceId, type])
  @@index([documentId])
}

model AuditEvent {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  actorUserId  String?   @db.Uuid
  action       String    @db.VarChar(150)
  resourceType String    @db.VarChar(100)
  resourceId   String?   @db.VarChar(100)
  metadata     Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor        User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId])
  @@index([workspaceId, resourceType, resourceId])
}

model Plan {
  id                          String                             @id @default(uuid()) @db.Uuid
  code                        String                             @unique @db.VarChar(50)
  name                        String                             @db.VarChar(100)
  description                 String?                            @db.Text
  betaPrice                   Decimal                            @default(0) @db.Decimal(19, 4)
  monthlyPrice                Decimal                            @default(0) @db.Decimal(19, 4)
  currency                    String                             @default("GHS") @db.VarChar(3)
  billingMode                 PlanBillingMode                    @default(FREE)
  paystackPlanCode            String?                            @unique @db.VarChar(100)
  documentLimit               Int?
  memberLimit                 Int?
  isPublic                    Boolean                            @default(true)
  isActive                    Boolean                            @default(true)
  isAvailableForNewWorkspaces Boolean                            @default(true)
  sortOrder                   Int                                @default(0)
  features                    Json                               @default("{}")
  createdAt                   DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                           @updatedAt @db.Timestamptz(3)
  subscriptions               Subscription[]
  fallbackSubscriptions       Subscription[]                     @relation("SubscriptionFallbackPlan")
  pendingSubscriptions        Subscription[]                     @relation("SubscriptionPendingPlan")
  subscriptionChanges         SubscriptionChange[]               @relation("SubscriptionChangeTargetPlan")
  subscriptionBillingPeriods  SubscriptionBillingPeriod[]
  allowancePeriods            WorkspaceDocumentAllowancePeriod[]
  trialConfigurationsAsPlan   TrialConfiguration[]               @relation("TrialConfigurationPlan")
  trialConfigurationsFallback TrialConfiguration[]               @relation("TrialConfigurationFallback")
  workspaceTrialsAsPlan       WorkspaceTrial[]                   @relation("WorkspaceTrialPlan")
  workspaceTrialsAsFallback   WorkspaceTrial[]                   @relation("WorkspaceTrialFallback")

  @@index([isPublic, isActive, isAvailableForNewWorkspaces])
  @@index([sortOrder, code])
}

model TrialConfiguration {
  id                    String   @id @default("GLOBAL") @db.VarChar(20)
  enabled               Boolean  @default(true)
  trialPlanId           String   @db.Uuid
  durationDays          Int      @default(14)
  fallbackPlanId        String   @db.Uuid
  newWorkspacesOnly     Boolean  @default(true)
  oneTrialPerWorkspace  Boolean  @default(true)
  paymentMethodRequired Boolean  @default(false)
  allowManualGrant      Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  trialPlan             Plan     @relation("TrialConfigurationPlan", fields: [trialPlanId], references: [id], onDelete: Restrict)
  fallbackPlan          Plan     @relation("TrialConfigurationFallback", fields: [fallbackPlanId], references: [id], onDelete: Restrict)

  @@index([trialPlanId])
  @@index([fallbackPlanId])
}

model WorkspaceTrial {
  id                         String               @id @default(uuid()) @db.Uuid
  workspaceId                String               @db.Uuid
  trialPlanId                String               @db.Uuid
  fallbackPlanId             String               @db.Uuid
  status                     WorkspaceTrialStatus @default(ACTIVE)
  startsAt                   DateTime             @db.Timestamptz(3)
  endsAt                     DateTime             @db.Timestamptz(3)
  grantedByUserId            String?              @db.Uuid
  grantSource                TrialGrantSource
  cancelledAt                DateTime?            @db.Timestamptz(3)
  expiredAt                  DateTime?            @db.Timestamptz(3)
  convertedAt                DateTime?            @db.Timestamptz(3)
  trialPlanCodeSnapshot      String               @db.VarChar(50)
  trialPlanNameSnapshot      String               @db.VarChar(100)
  trialMemberLimitSnapshot   Int?
  trialDocumentLimitSnapshot Int?
  trialFeaturesSnapshot      Json                 @default("{}")
  fallbackPlanCodeSnapshot   String               @db.VarChar(50)
  fallbackPlanNameSnapshot   String               @db.VarChar(100)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(3)
  workspace                  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  trialPlan                  Plan                 @relation("WorkspaceTrialPlan", fields: [trialPlanId], references: [id], onDelete: Restrict)
  fallbackPlan               Plan                 @relation("WorkspaceTrialFallback", fields: [fallbackPlanId], references: [id], onDelete: Restrict)
  grantedBy                  User?                @relation("WorkspaceTrialGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId], map: "WorkspaceTrial_one_active_per_workspace_key", where: { status: "ACTIVE" })
  @@index([workspaceId, createdAt])
  @@index([status, endsAt])
  @@index([trialPlanId, status])
  @@index([fallbackPlanId])
  @@index([grantedByUserId])
}

model Subscription {
  id                       String                      @id @default(uuid()) @db.Uuid
  workspaceId              String                      @unique @db.Uuid
  planId                   String                      @db.Uuid
  fallbackPlanId           String?                     @db.Uuid
  pendingPlanId            String?                     @db.Uuid
  status                   SubscriptionStatus          @default(BETA)
  provider                 PaymentProvider?
  providerCustomerCode     String?                     @db.VarChar(100)
  providerSubscriptionCode String?                     @unique @db.VarChar(100)
  currentPeriodStart       DateTime?                   @db.Timestamptz(3)
  currentPeriodEnd         DateTime?                   @db.Timestamptz(3)
  nextPaymentAt            DateTime?                   @db.Timestamptz(3)
  lastPaymentAt            DateTime?                   @db.Timestamptz(3)
  cancelAtPeriodEnd        Boolean                     @default(false)
  startedAt                DateTime                    @default(now()) @db.Timestamptz(3)
  endsAt                   DateTime?                   @db.Timestamptz(3)
  createdAt                DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                    @updatedAt @db.Timestamptz(3)
  workspace                Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  plan                     Plan                        @relation(fields: [planId], references: [id], onDelete: Restrict)
  fallbackPlan             Plan?                       @relation("SubscriptionFallbackPlan", fields: [fallbackPlanId], references: [id], onDelete: Restrict)
  pendingPlan              Plan?                       @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id], onDelete: Restrict)
  changes                  SubscriptionChange[]
  billingPeriods           SubscriptionBillingPeriod[]

  @@index([planId])
  @@index([fallbackPlanId])
  @@index([pendingPlanId])
  @@index([status])
  @@index([provider, providerCustomerCode])
  @@index([currentPeriodEnd])
}

model SubscriptionChange {
  id                       String                   @id @default(uuid()) @db.Uuid
  workspaceId              String                   @db.Uuid
  subscriptionId           String                   @db.Uuid
  targetPlanId             String                   @db.Uuid
  actorUserId              String?                  @db.Uuid
  status                   SubscriptionChangeStatus @default(PENDING)
  fromPlanCodeSnapshot     String                   @db.VarChar(50)
  targetPlanCodeSnapshot   String                   @db.VarChar(50)
  targetPlanNameSnapshot   String                   @db.VarChar(100)
  priceSnapshot            Decimal                  @db.Decimal(19, 4)
  currencySnapshot         String                   @db.Char(3)
  providerPlanCodeSnapshot String                   @db.VarChar(100)
  providerCustomerCode     String?                  @db.VarChar(100)
  providerSubscriptionCode String?                  @unique @db.VarChar(100)
  providerNextPaymentAt    DateTime?                @db.Timestamptz(3)
  createdAt                DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(3)
  completedAt              DateTime?                @db.Timestamptz(3)
  failedAt                 DateTime?                @db.Timestamptz(3)
  cancelledAt              DateTime?                @db.Timestamptz(3)
  workspace                Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subscription             Subscription             @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  targetPlan               Plan                     @relation("SubscriptionChangeTargetPlan", fields: [targetPlanId], references: [id], onDelete: Restrict)
  actor                    User?                    @relation("SubscriptionChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  payments                 Payment[]

  @@unique([subscriptionId], map: "SubscriptionChange_one_pending_per_subscription_key", where: { status: "PENDING" })
  @@index([workspaceId, createdAt])
  @@index([targetPlanId, status])
  @@index([providerCustomerCode])
  @@index([actorUserId])
}

model SubscriptionBillingPeriod {
  id                           String                          @id @default(uuid()) @db.Uuid
  subscriptionId               String                          @db.Uuid
  planId                       String                          @db.Uuid
  status                       SubscriptionBillingPeriodStatus @default(PENDING)
  providerInvoiceCode          String?                         @unique @db.VarChar(100)
  providerTransactionReference String?                         @unique @db.VarChar(100)
  periodStart                  DateTime                        @db.Timestamptz(3)
  periodEnd                    DateTime                        @db.Timestamptz(3)
  amount                       Decimal                         @db.Decimal(19, 4)
  currency                     String                          @db.Char(3)
  createdAt                    DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                        @updatedAt @db.Timestamptz(3)
  paidAt                       DateTime?                       @db.Timestamptz(3)
  failedAt                     DateTime?                       @db.Timestamptz(3)
  subscription                 Subscription                    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan                         Plan                            @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment                      Payment?

  @@unique([subscriptionId, periodStart])
  @@index([subscriptionId, periodEnd])
  @@index([planId, status])
  @@index([status, periodEnd])
}

model DocumentCreditPack {
  id           String                      @id @default(uuid()) @db.Uuid
  code         String                      @unique @db.VarChar(50)
  name         String                      @db.VarChar(100)
  description  String?                     @db.Text
  creditAmount Int
  price        Decimal                     @default(0) @db.Decimal(19, 4)
  currency     String                      @default("GHS") @db.Char(3)
  isActive     Boolean                     @default(true)
  isPublic     Boolean                     @default(true)
  sortOrder    Int                         @default(0)
  createdAt    DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                    @updatedAt @db.Timestamptz(3)
  purchases    DocumentCreditPurchase[]
  transactions DocumentCreditTransaction[]

  @@index([isPublic, isActive, sortOrder])
}

model DocumentCreditPurchase {
  id                       String                       @id @default(uuid()) @db.Uuid
  workspaceId              String                       @db.Uuid
  packId                   String                       @db.Uuid
  actorUserId              String?                      @db.Uuid
  status                   DocumentCreditPurchaseStatus @default(PENDING)
  betaAcquisition          Boolean                      @default(false)
  creditAmountSnapshot     Int
  priceSnapshot            Decimal                      @db.Decimal(19, 4)
  currencySnapshot         String                       @db.Char(3)
  externalPaymentReference String?                      @unique @db.VarChar(255)
  createdAt                DateTime                     @default(now()) @db.Timestamptz(3)
  completedAt              DateTime?                    @db.Timestamptz(3)
  workspace                Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  pack                     DocumentCreditPack           @relation(fields: [packId], references: [id], onDelete: Restrict)
  actor                    User?                        @relation("DocumentCreditPurchaseActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  ledgerEntry              DocumentCreditTransaction?
  payments                 Payment[]

  @@unique([workspaceId, packId], map: "DocumentCreditPurchase_beta_workspace_pack_key", where: { betaAcquisition: true })
  @@unique([workspaceId, packId], map: "DocumentCreditPurchase_pending_paid_workspace_pack_key", where: { status: "PENDING", betaAcquisition: false })
  @@index([workspaceId, status, createdAt])
  @@index([packId, status])
  @@index([actorUserId])
}

model DocumentCreditTransaction {
  id              String                        @id @default(uuid()) @db.Uuid
  workspaceId     String                        @db.Uuid
  type            DocumentCreditTransactionType
  amount          Int
  source          String                        @db.VarChar(100)
  sourceReference String                        @unique @db.VarChar(255)
  packId          String?                       @db.Uuid
  purchaseId      String?                       @unique @db.Uuid
  refundId        String?                       @unique @db.Uuid
  actorUserId     String?                       @db.Uuid
  metadata        Json?
  createdAt       DateTime                      @default(now()) @db.Timestamptz(3)
  workspace       Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  pack            DocumentCreditPack?           @relation(fields: [packId], references: [id], onDelete: Restrict)
  purchase        DocumentCreditPurchase?       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  refund          PaymentRefund?                @relation(fields: [refundId], references: [id], onDelete: Restrict)
  actor           User?                         @relation("DocumentCreditTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, type])
  @@index([packId])
  @@index([actorUserId])
}

model WorkspaceDocumentAllowancePeriod {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  planId      String    @db.Uuid
  periodStart DateTime  @db.Timestamptz(3)
  periodEnd   DateTime  @db.Timestamptz(3)
  allowance   Int?
  used        Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, periodStart])
  @@index([workspaceId, periodEnd])
  @@index([planId])
}

model Payment {
  id                          String                     @id @default(uuid()) @db.Uuid
  workspaceId                 String                     @db.Uuid
  initiatedByUserId           String?                    @db.Uuid
  purpose                     PaymentPurpose
  provider                    PaymentProvider
  internalReference           String                     @unique @db.VarChar(100)
  providerReference           String?                    @unique @db.VarChar(100)
  amount                      Decimal                    @db.Decimal(19, 4)
  currency                    String                     @db.Char(3)
  status                      PaymentStatus              @default(PENDING)
  metadata                    Json?
  createdAt                   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                   @updatedAt @db.Timestamptz(3)
  completedAt                 DateTime?                  @db.Timestamptz(3)
  failedAt                    DateTime?                  @db.Timestamptz(3)
  cancelledAt                 DateTime?                  @db.Timestamptz(3)
  reconciliationStatus        PaymentReconciliationStatus @default(NOT_REQUIRED)
  reconciliationNote          String?                    @db.VarChar(255)
  reconciledAt                DateTime?                  @db.Timestamptz(3)
  documentCreditPurchaseId    String?                    @db.Uuid
  subscriptionChangeId        String?                    @db.Uuid
  subscriptionBillingPeriodId String?                    @unique @db.Uuid
  workspace                   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  initiatedBy                 User?                      @relation("PaymentInitiator", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  documentCreditPurchase      DocumentCreditPurchase?    @relation(fields: [documentCreditPurchaseId], references: [id], onDelete: Restrict)
  subscriptionChange          SubscriptionChange?        @relation(fields: [subscriptionChangeId], references: [id], onDelete: Restrict)
  subscriptionBillingPeriod   SubscriptionBillingPeriod? @relation(fields: [subscriptionBillingPeriodId], references: [id], onDelete: Restrict)
  attempts                    PaymentAttempt[]
  refunds                     PaymentRefund[]

  @@index([workspaceId, createdAt])
  @@index([initiatedByUserId, createdAt])
  @@index([status, createdAt])
  @@index([provider, providerReference])
  @@index([documentCreditPurchaseId, status])
  @@index([subscriptionChangeId, status])
}

model PaymentRefund {
  id                    String                      @id @default(uuid()) @db.Uuid
  paymentId             String                      @db.Uuid
  workspaceId           String                      @db.Uuid
  initiatedByUserId     String?                     @db.Uuid
  provider              PaymentProvider
  internalReference     String                      @unique @db.VarChar(100)
  providerRefundId      String?                     @unique @db.VarChar(100)
  providerRefundReference String?                   @unique @db.VarChar(100)
  status                PaymentRefundStatus         @default(REQUESTED)
  active                Boolean                     @default(true)
  amount                Decimal                     @db.Decimal(19, 4)
  currency              String                      @db.Char(3)
  creditAmount          Int?
  reason                String                      @db.VarChar(500)
  safeFailureCode       String?                     @db.VarChar(100)
  expectedAt            DateTime?                   @db.Timestamptz(3)
  refundedAt            DateTime?                   @db.Timestamptz(3)
  completedAt           DateTime?                   @db.Timestamptz(3)
  failedAt              DateTime?                   @db.Timestamptz(3)
  createdAt             DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @db.Timestamptz(3)
  payment               Payment                     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  workspace             Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  initiatedBy           User?                       @relation("PaymentRefundInitiator", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  creditLedgerEntry     DocumentCreditTransaction?

  @@unique([paymentId], map: "PaymentRefund_one_active_per_payment_key", where: { active: true })
  @@index([paymentId, status, createdAt])
  @@index([workspaceId, createdAt])
  @@index([initiatedByUserId, createdAt])
  @@index([status, createdAt])
}

model PaymentAttempt {
  id                 String               @id @default(uuid()) @db.Uuid
  paymentId          String               @db.Uuid
  provider           PaymentProvider
  providerReference  String               @unique @db.VarChar(100)
  providerAccessCode String?              @db.VarChar(255)
  authorizationUrl   String?              @db.Text
  status             PaymentAttemptStatus @default(PENDING)
  requestMetadata    Json?
  responseMetadata   Json?
  initializedAt      DateTime             @default(now()) @db.Timestamptz(3)
  verifiedAt         DateTime?            @db.Timestamptz(3)
  completedAt        DateTime?            @db.Timestamptz(3)
  failedAt           DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  payment            Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model PaymentProviderEvent {
  id                String                     @id @default(uuid()) @db.Uuid
  provider          PaymentProvider
  eventKey          String                     @unique @db.Char(64)
  payloadHash       String                     @db.Char(64)
  eventType         String                     @db.VarChar(100)
  providerReference String?                    @db.VarChar(100)
  status            PaymentProviderEventStatus @default(RECEIVED)
  safeData          Json?
  receivedAt        DateTime                   @default(now()) @db.Timestamptz(3)
  processedAt       DateTime?                  @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([provider, providerReference])
  @@index([status, receivedAt])
  @@index([eventType, receivedAt])
}
